{
	"name": "@svar-ui/svelte-grid",
	"version": "2.7.6",
	"description": "A fast, feature-rich Svelte DataGrid component",
	"keywords": [
		"data grid",
		"data table",
		"data-grid",
		"data-table",
		"datagrid",
		"datatable",
		"svar datagrid",
		"svar widgets",
		"svelte",
		"svelte datagrid",
		"svelte datatable",
		"svelte-data-grid",
		"svelte-datagrid",
		"svelte-table",
		"ui component"
	],
	"homepage": "https://svar.dev/svelte/datagrid/",
	"bugs": {
		"url": "https://forum.svar.dev"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/svar-widgets/grid.git"
	},
	"files": [
		"dist",
		"readme.md",
		"whatsnew.md",
		"license.txt"
	],
	"type": "module",
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"svelte": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"build": "svelte-package -i ./src",
		"dev": "svelte-package -i ./src --watch"
	},
	"dependencies": {
		"@svar-ui/grid-data-provider": "workspace:*",
		"@svar-ui/grid-locales": "workspace:*",
		"@svar-ui/grid-store": "workspace:*",
		"@svar-ui/lib-dom": "catalog:",
		"@svar-ui/lib-state": "catalog:",
		"@svar-ui/lib-svelte": "catalog:",
		"@svar-ui/svelte-core": "catalog:",
		"@svar-ui/svelte-menu": "catalog:",
		"@svar-ui/svelte-toolbar": "catalog:"
	},
	"devDependencies": {
		"@sveltejs/package": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"productTag": "grid"
}
